{
  "info": {
    "name": "WorldOfLamps API",
    "description": "Коллекция для микросервисов auth (8003), products (8001) и orders (8002).\n\n## Переменные коллекции\n- `auth_url` — http://localhost:8003\n- `products_url` — http://localhost:8001\n- `orders_url` — http://localhost:8002\n- `access_token` — заполняется автоматически после POST /api/auth/login\n- `product_id` — id товара для тестов (по умолчанию 1)\n- `created_product_id` — заполняется после Create product\n- `order_id` — заполняется автоматически после создания заказа\n- `order_number` — заполняется автоматически после создания заказа\n\n## Порядок для видеодемонстрации (Задание 5 — Админка с JWT)\n1. Auth → Login as admin (admin/admin123) — сохраняет access_token\n2. Auth → Me — показать, что токен валидный\n3. Products (admin) → Create / Update / Delete — все с Bearer токеном\n4. Orders (admin) → List, Update status — с Bearer токеном\n5. Без токена (открыть запрос без Authorization) → 401\n\n## Логин\nadmin / admin123 (сидится в init.sql)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "b2f4a8c0-1111-2222-3333-worldoflamps"
  },
  "variable": [
    { "key": "auth_url", "value": "http://localhost:8003", "type": "string" },
    { "key": "products_url", "value": "http://localhost:8001", "type": "string" },
    { "key": "orders_url", "value": "http://localhost:8002", "type": "string" },
    { "key": "access_token", "value": "", "type": "string" },
    { "key": "product_id", "value": "1", "type": "string" },
    { "key": "created_product_id", "value": "", "type": "string" },
    { "key": "order_id", "value": "", "type": "string" },
    { "key": "order_number", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{auth_url}}/health", "host": ["{{auth_url}}"], "path": ["health"] }
          }
        },
        {
          "name": "Login as admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set('access_token', data.access_token);",
                  "  console.log('Saved token for', data.user.username);",
                  "}",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has access_token', () => pm.expect(pm.response.json().access_token).to.be.a('string'));",
                  "pm.test('Has user payload', () => pm.expect(pm.response.json().user.username).to.eql('admin'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{auth_url}}/api/auth/login",
              "host": ["{{auth_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Авторизация админа. Возвращает access_token. Скрипт автоматически сохраняет токен в переменную коллекции."
          }
        },
        {
          "name": "Login — wrong password (expect 401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"wrong\"\n}"
            },
            "url": {
              "raw": "{{auth_url}}/api/auth/login",
              "host": ["{{auth_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Me (requires token)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": {
              "raw": "{{auth_url}}/api/auth/me",
              "host": ["{{auth_url}}"],
              "path": ["api", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Products (public)",
      "item": [
        {
          "name": "List categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{products_url}}/api/products/categories",
              "host": ["{{products_url}}"],
              "path": ["api", "products", "categories"]
            }
          }
        },
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{products_url}}/api/products/products?page=1&per_page=12",
              "host": ["{{products_url}}"],
              "path": ["api", "products", "products"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "12" }
              ]
            }
          }
        },
        {
          "name": "Get product by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{products_url}}/api/products/products/{{product_id}}",
              "host": ["{{products_url}}"],
              "path": ["api", "products", "products", "{{product_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Products (admin — JWT)",
      "item": [
        {
          "name": "Create product (no token → 401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test product (should fail)\",\n  \"category_id\": 1,\n  \"description\": \"...\",\n  \"price\": 100,\n  \"stock\": 10\n}"
            },
            "url": {
              "raw": "{{products_url}}/api/products/products",
              "host": ["{{products_url}}"],
              "path": ["api", "products", "products"]
            },
            "description": "Демо: без токена возвращается 401."
          }
        },
        {
          "name": "Create product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('created_product_id', String(pm.response.json().id));",
                  "}",
                  "pm.test('Status 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Тестовая лампа админ\",\n  \"category_id\": 1,\n  \"description\": \"Создано из админки\",\n  \"price\": 149.00,\n  \"stock\": 25\n}"
            },
            "url": {
              "raw": "{{products_url}}/api/products/products",
              "host": ["{{products_url}}"],
              "path": ["api", "products", "products"]
            }
          }
        },
        {
          "name": "Update product",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 159.00,\n  \"stock\": 30\n}"
            },
            "url": {
              "raw": "{{products_url}}/api/products/products/{{created_product_id}}",
              "host": ["{{products_url}}"],
              "path": ["api", "products", "products", "{{created_product_id}}"]
            }
          }
        },
        {
          "name": "Delete product (soft)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{products_url}}/api/products/products/{{created_product_id}}",
              "host": ["{{products_url}}"],
              "path": ["api", "products", "products", "{{created_product_id}}"]
            }
          }
        },
        {
          "name": "Create category",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Тестовая категория\",\n  \"slug\": \"test-cat\"\n}"
            },
            "url": {
              "raw": "{{products_url}}/api/products/categories",
              "host": ["{{products_url}}"],
              "path": ["api", "products", "categories"]
            }
          }
        }
      ]
    },
    {
      "name": "Orders (public)",
      "item": [
        {
          "name": "Create order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set('order_id', String(data.id));",
                  "  pm.collectionVariables.set('order_number', data.order_number);",
                  "}",
                  "pm.test('Status 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_name\": \"Иван Петров\",\n  \"customer_phone\": \"+7 900 123-45-67\",\n  \"customer_address\": \"г. Москва, ул. Ленина, д. 1\",\n  \"items\": [\n    { \"product_id\": 1, \"quantity\": 2 }\n  ]\n}"
            },
            "url": {
              "raw": "{{orders_url}}/api/orders",
              "host": ["{{orders_url}}"],
              "path": ["api", "orders"]
            }
          }
        },
        {
          "name": "Get order by number",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{orders_url}}/api/orders/{{order_number}}",
              "host": ["{{orders_url}}"],
              "path": ["api", "orders", "{{order_number}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Orders (admin — JWT)",
      "item": [
        {
          "name": "List orders (no token → 401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{orders_url}}/api/orders",
              "host": ["{{orders_url}}"],
              "path": ["api", "orders"]
            }
          }
        },
        {
          "name": "List orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": {
              "raw": "{{orders_url}}/api/orders?per_page=50",
              "host": ["{{orders_url}}"],
              "path": ["api", "orders"],
              "query": [{ "key": "per_page", "value": "50" }]
            }
          }
        },
        {
          "name": "Update status → processing",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"processing\"\n}"
            },
            "url": {
              "raw": "{{orders_url}}/api/orders/{{order_id}}/status",
              "host": ["{{orders_url}}"],
              "path": ["api", "orders", "{{order_id}}", "status"]
            }
          }
        },
        {
          "name": "Update status → shipped",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"shipped\"\n}"
            },
            "url": {
              "raw": "{{orders_url}}/api/orders/{{order_id}}/status",
              "host": ["{{orders_url}}"],
              "path": ["api", "orders", "{{order_id}}", "status"]
            }
          }
        },
        {
          "name": "Update status → delivered",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"delivered\"\n}"
            },
            "url": {
              "raw": "{{orders_url}}/api/orders/{{order_id}}/status",
              "host": ["{{orders_url}}"],
              "path": ["api", "orders", "{{order_id}}", "status"]
            }
          }
        }
      ]
    }
  ]
}
